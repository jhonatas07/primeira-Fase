programa {
  funcao inicio() {
    // entendimento do problema 
      // calcular o horário de retorno de recreio
    // info e variaveis 
    inteiro hora, minuto
    // entrada de dados
    escreva("hora do começo: ")
    leia(hora)
    escreva("minuto do começo: ")
    leia(minuto)
    // processamento 
    minuto = minuto + 20
    //saída
    escreva("recreio termina:\n ")
    escreva(hora)
    escreva(":")
    escreva(minuto)
   //escreva("O que acontece com quem chega depois do horário ")
    escreva("nao entra na sala ")
  leia(hora,minuto )
  hora = minuto + 1
  


  }
}
