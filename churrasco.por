programa {
  funcao inicio() {
    // entendimento
      // ler a quamtidade de pessoas e calcular a quantidade de produtos para comprar

    // informacoes e variaveis
    inteiro pessoas
    real carne, cerveja, agua, refri
    // entrada de dados
    escreva("Quantidade de pessoas:  ")
    leia(pessoas)
    // processamento
    carne = pessoas * 0.5
    cerveja = pessoas * 1
    agua = pessoas * 2
    refri = pessoas * 1
    // saidas
    escreva("carne : " + carne)
    escreva("\ncerveja : " + cerveja)
    escreva("\nágua : " + agua)
    escreva("\nrefri : " + refri)
    


  }
}
