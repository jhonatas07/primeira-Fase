programa {
  funcao inicio() {
    inteiro inicial, final, vendas
    escreva("qual a quantidade inicial de laranjas? ")
    leia(inicial)
    escreva("qual a quantidade final de laranjas? ")
    leia(final)
vendas = inicial - final
escreva("Seu total de laranjas vendidas é de: ")
escreva(vendas)
  }
}
