programa {
  funcao inicio() {
    real salario, valor, dias
    inteiro semana
    escreva("qual seu salario mensal? ")
    leia(salario)
    escreva("qauntos dias voce trabalhou? ")
    leia(dias)
    semana = 5
    valor = salario / dias * 5
   
    escreva("salario semanal e igual a: ")
    escreva(valor)

  }
}
